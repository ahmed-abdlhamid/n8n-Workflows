      "id": "ae627f02-3e10-45d7-9942-6dad97c79e23",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message?.text || $json.text || Object.values($json)[0] }}",
        "options": {
          "systemMessage": "=Your role is the Agency Executive Manager & Dynamic Router. \nAnalyze the incoming client request and decide which corporate resources are required. \nOutput a JSON object with the following parameters:\n1. Core_Goal: The final deliverable requested.\n2. Needs_Web_Research: (true/false) Does this require live market data?\n3. Domain_Context: (e.g., Real Estate, Medical, Tech) To fetch the correct brand guidelines from our vector knowledge base.\n4. Tone_Style: Desired tone.\n\nOutput strictly in JSON format. No conversational filler."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -48,
        -240
      ],
      "id": "44ebd417-16b8-4bf1-a5d0-baf66d3a1a49",
      "name": "The Manager Agent"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.output }}",
        "options": {
          "systemMessage": "=Your role is the Senior Research Agent. Based on the analysis blueprint provided by the Manager, you must gather, verify, and organize relevant data, market trends, and facts.\n\nSynthesize your findings into a detailed, highly factual \"Research Dossier\". Focus on numbers, metrics, and accurate local insights (e.g., real estate trends, digital behavior). Keep it objective, concise, and structured with bullet points. Do not write marketing copy yet."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        288,
        16
      ],
      "id": "7331d613-a2ed-4a6a-a8cf-5440309ba9df",
      "name": "The Research Agent"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.user_message || $json.output || $input.item.json.user_message }}",
        "options": {
          "systemMessage": "=Your role is the Creative Copywriter. Take the Research Dossier provided by the Research Agent and craft the final content requested by the client (e.g., social media posts, email sequences, or articles).\n\nGuidelines:\n- Match the requested Tone and Target Audience specified in the initial blueprint.\n- Structure the content beautifully using emojis, compelling hooks, and a strong Call to Action (CTA).\n- Ensure the copy is engaging and natural."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        -256
      ],
      "id": "847097db-7e8d-4694-b45a-95aab26206c8",
      "name": "The Copywriter Agent"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.output }}",
        "options": {
          "systemMessage": "=Your role is the Senior Content Auditor and Optimization Agent. Your job is NOT just to find mistakes, but to actively FIX them and output a production-ready result.\n\nYou will receive the content drafted by the Copywriter. Review it, instantly remove any forbidden AI clichés (like 'Delve', 'Revolutionize', 'In today's digital landscape'), and clean up the language.\n\nOutput your final decision STRICTLY in this JSON format:\n{\n  \"quality_score\": 9,\n  \"detailed_feedback\": \"None. Content automatically optimized and approved.\",\n  \"revised_content\": \"Your fully rewritten, polished, and beautifully formatted Arabic marketing text goes here.\"\n}\n\nCRITICAL RULES:\n1. Since you have edited the text yourself, ALWAYS set the \"quality_score\" to 9 or 10.\n2. Ensure the \"revised_content\" is fully polished and directly ready to be sent to the client.\n3. Output ONLY the raw JSON object. No conversational text."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1056,
        16
      ],
      "id": "3367614c-d09a-48b1-93e8-99ea9ee2b615",
      "name": "The Auditor Agent"
