    {
      "parameters": {
        "jsCode": "// 1. جلب بيانات ملفات Google Drive مباشرة من العقدة الخاصة بها\nconst driveItems = $items(\"Search files and folders\") || [];\n\n// 2. جلب صفوف Google Sheet مباشرة من العقدة الخاصة بها\nconst sheetItems = $items(\"Get row(s) in sheet\") || [];\n\n// 3. تجميع كافة الـ IDs الموجودة بالفعل في الشيت\nconst processedIds = new Set();\nfor (const item of sheetItems) {\n  const row = item.json;\n  // البحث عن حقل الـ ID بغض النظر عن حالة الأحرف\n  const idValue = row.ID || row.id || row.Id;\n  if (idValue) {\n    processedIds.add(String(idValue).trim());\n  }\n}\n\n// 4. فلترة ملفات Drive للحصول على الملفات الجديدة فقط\nconst newFiles = [];\nfor (const item of driveItems) {\n  const file = item.json;\n  const fileId = String(file.id || file.Id).trim();\n  \n  // إذا لم يكن الـ ID موجوداً في الشيت، إذن هو ملف جديد\n  if (fileId && !processedIds.has(fileId)) {\n    newFiles.push({\n      json: {\n        fileId: fileId,\n        fileName: file.name || file.Name,\n        Id: fileId,\n        Name: file.name || file.Name\n      }\n    });\n  }\n}\n\nconsole.log(`إجمالي ملفات درايف: ${driveItems.length}`);\nconsole.log(`إجمالي ملفات الشيت: ${sheetItems.length}`);\nconsole.log(`الملفات الجديدة المطلوبة: ${newFiles.length}`);\n\n// إرجاع الملفات الجديدة فقط لتكملة الوركفلو\nreturn newFiles;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        288
      ],
      "id": "5eade380-a0dc-47b8-9e77-a3cc767c6ff1",
      "name": "Code in JavaScript",
